# ==============================================================================
# CropSense AI — Git Ignore Rules
# ==============================================================================

# Python Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Node.js & Frontend Dependencies
node_modules/
frontend/node_modules/
frontend/build/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Secrets & Environment Configurations (Keep .env.example)
.env
.env*.local
backend/.env
frontend/.env
!.env.example
!frontend/.env.example

# IDE & Editor Artifacts
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Runtime Logs & Temporary Files
*.log
scratch/
tmp/
temp/

# Note: Models (models/) and Datasets (datasets/, data/) are deliberately TRACKED.
# All model files are < 15 MB, well within GitHub's standard 100 MB file limit.
