# CropSense AI — Environment Variables Template
# Copy this file to backend/.env and provide your valid credentials:
# cp .env.example backend/.env

# OpenWeatherMap API Key (Free Tier supported)
# Sign up at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ── Krishi Mitra chatbot (SoilGrids + RAG) ──────────────────────────────────
# LLM provider: auto | gemini | anthropic | offline
#   auto    -> Gemini if GEMINI_API_KEY is set, else Claude if ANTHROPIC_API_KEY is set, else offline
#   offline -> no AI: answers show the retrieved soil data + knowledge excerpts (free, English only)
LLM_PROVIDER=auto

# Google Gemini (free tier available, no card needed): https://aistudio.google.com/apikey
# Free-tier prompts may be used by Google to improve its products; do not enter personal data.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Anthropic Claude (paid): https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Optional tuning (defaults shown)
# RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
# RAG_TOP_K=6
# SOILGRIDS_TIMEOUT_S=25
# SOILGRIDS_TOTAL_BUDGET_S=60
# SOILGRIDS_BATCH_SIZE=3
